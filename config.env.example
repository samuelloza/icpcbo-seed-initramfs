# Config del mini. build.sh la hornea en la ISO (/etc/mini-deploy/config.env) si
# existe; lan-fetch.sh la lee al arrancar en el equipo.

CONTEST_DIR="/icpc_bo"
MINI_MEDIA_DIR="/run/mini-media"
LAN_DIR="/usr/lib/mini-deploy/lan"
MINI_STAGING_MIB="5120"

# Origen HTTP del runtime. Lo usan LOS EQUIPOS al arrancar (no el build): de aquí
# bajan manifest.json, el .torrent y los ficheros del runtime si no hay USB.
# Es el directorio de la versión; manifest.json y contest-*.torrent se buscan un
# nivel arriba, o en MINI_METADATA_URL si se define.
MINI_ARTIFACT_URL="http://10.0.0.1:8081/artifacts/YYYYMMDDHHMMSS"
# MINI_METADATA_URL="http://10.0.0.1:8081"

# Tracker BT opcional, respaldo de Local Peer Discovery. Levantar en el origen,
# p. ej.:  opentracker -p 6969 -P 6969
# MINI_TRACKER_URL="http://10.0.0.1:6969/announce"
