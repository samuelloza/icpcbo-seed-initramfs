#!/bin/sh
# PID 1 del mini sistema: no inicia systemd, solo monta lo mínimo, levanta la
# red y lanza el flujo de despliegue. Al final, lan-fetch.sh salta con kexec al
# runtime copiado en el disco.

show_error() {
    clear 2>/dev/null || true
    echo
    echo '  =================================================='
    echo '          ERROR EN LA PREPARACIÓN DEL EQUIPO'
    echo '  =================================================='
    echo
    echo "  $*"
    echo
    echo '  El sistema queda detenido para revisión.'
    echo

    while :; do sleep 3600; done
}

mountpoint -q /proc || mount -t proc proc /proc 2>/dev/null || true
mountpoint -q /sys || mount -t sysfs sysfs /sys 2>/dev/null || true
mountpoint -q /run || mount -t tmpfs tmpfs /run 2>/dev/null || true

if command -v dbus-daemon >/dev/null 2>&1; then
    dbus-daemon --system --fork 2>/dev/null || true
fi

if command -v NetworkManager >/dev/null 2>&1; then
    NetworkManager --no-daemon >/var/log/mini-network.log 2>&1 &
fi

if ! /usr/lib/mini-deploy/deploy-run.sh; then
    show_error 'El flujo de red o preparación terminó con error.'
fi
